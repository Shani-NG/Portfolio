# Set these privately in .env.local for local development and in Vercel for hosting.
SITE_PASSWORD=replace-with-a-strong-shared-password
ACCESS_SESSION_SECRET=replace-with-a-long-random-secret

# Role Fit Agent model provider.
# Use "mock" for local vertical-slice testing without external model calls.
# Use "gemini" after adding a private Google AI Studio key.
ROLE_FIT_MODEL_PROVIDER=mock
GOOGLE_AI_STUDIO_API_KEY=replace-with-private-key-in-env-local
GOOGLE_AI_STUDIO_MODEL=replace-with-google-ai-studio-model-id
