# Set these privately in .env.local for local development and in Vercel for hosting.
SITE_PASSWORD=replace-with-a-strong-shared-password
ACCESS_SESSION_SECRET=replace-with-a-long-random-secret

# Role Fit Agent model provider.
# Use "mock" for local vertical-slice testing without external model calls.
# Use "gemini" after adding a private Google AI Studio key.
ROLE_FIT_MODEL_PROVIDER=mock
GOOGLE_AI_STUDIO_API_KEY=replace-with-private-key-in-env-local
GOOGLE_AI_STUDIO_MODEL=gemini-3-flash-preview
GOOGLE_AI_STUDIO_CHAT_MODEL=gemini-3-flash-preview
GOOGLE_AI_STUDIO_ANALYSIS_MODEL=gemini-3-flash-preview
ROLE_FIT_MAX_MESSAGES_PER_SESSION=30
ROLE_FIT_MAX_REPORTS_PER_SESSION=2
ROLE_FIT_MAX_INPUT_CHARS=12000
ROLE_FIT_MAX_OUTPUT_TOKENS=2500

# Optional Role Fit runtime store for Google Sheets.
# Create one spreadsheet with tabs: sessions, events, reports, leads.
# Share the spreadsheet with the service account email.
GOOGLE_SHEETS_RUNTIME_SPREADSHEET_ID=replace-with-google-sheet-id
GOOGLE_SHEETS_CLIENT_EMAIL=replace-with-service-account-email
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_RUNTIME_SESSIONS_TAB=sessions
GOOGLE_SHEETS_RUNTIME_EVENTS_TAB=events
GOOGLE_SHEETS_RUNTIME_REPORTS_TAB=reports
